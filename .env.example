# dev, staging or production. Dev login and the simulate-inbound helper only
# exist in dev. Outside dev the app refuses to start with default secrets.
ENV=dev

DATABASE_URL=postgresql+psycopg2://ticketing:ticketing@db:5432/ticketing

# Entra ID (Azure AD) app registration — client-credentials flow against the
# shared IT support mailbox. Needs app-only Mail.Read and Mail.Send
# permissions (admin-consented) scoped to the mailbox.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_SHARED_MAILBOX=itsupport@yourtenant.onmicrosoft.com
GRAPH_WEBHOOK_CLIENT_STATE=change-me

# Separate Entra ID app registration for user sign-in (delegated,
# authorization-code flow). Leave blank to fall back to the dev-only
# sign-in form at /auth/dev-login.
SSO_TENANT_ID=
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_REDIRECT_URI=http://localhost:8000/auth/callback

# Announce new tickets in a Teams channel. The switch is for every process that creates tickets;
# the webhook URL is a credential (anyone with it can post to the channel) and only the worker,
# which sends, needs it.
TEAMS_NEW_TICKET_ENABLED=false
TEAMS_NEW_TICKET_WEBHOOK_URL=
# Also send agents' unread notifications to that channel (an @mention of the person).
TEAMS_NOTIFICATIONS_ENABLED=false
# Out-of-office detection: the worker reads agents' presence from Microsoft Graph (needs the GRAPH_*
# credentials, with Presence.Read.All and User.Read.All admin-consented).
PRESENCE_ENABLED=false
# Email out of the shared mailbox (agent replies, automatic notices, approval requests). off: nothing is
# queued. dev: queued and recorded as sent without contacting Graph; read them at /admin/outbound-mail
# (dev environment only). graph: the worker sends through Graph and needs the GRAPH_* values and
# GRAPH_SHARED_MAILBOX (Mail.Send, admin-consented and limited to that mailbox).
MAIL_SENDING=off
# Where the app is reached (no trailing slash), so Teams cards can link to the ticket.
PUBLIC_BASE_URL=

# Used to sign session cookies. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET_KEY=change-me

# Comma-separated emails auto-promoted to super_admin on first login.
SUPER_ADMIN_EMAILS=

# Number of uvicorn worker processes (default 4).
# UVICORN_WORKERS=4
