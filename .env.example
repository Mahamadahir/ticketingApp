# dev, staging or production. Dev login and the simulate-inbound helper only
# exist in dev. Outside dev the app refuses to start with default secrets.
ENV=dev

# What this process serves: all (everything, dev only), web, public or worker. Outside dev it must be
# web, public or worker; the app refuses to start with it unset.
APP_ROLE=all

DATABASE_URL=postgresql+psycopg2://ticketing:ticketing@db:5432/ticketing

# Entra ID (Azure AD) app registration — client-credentials flow against the
# shared IT support mailbox. Needs app-only Mail.Read and Mail.Send
# permissions (admin-consented) scoped to the mailbox. Reading requesters' Outlook time zones also needs
# MailboxSettings.Read (application, admin-consented); without it everyone is shown the default time zone.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_SHARED_MAILBOX=itsupport@yourtenant.onmicrosoft.com
GRAPH_WEBHOOK_CLIENT_STATE=change-me

# Separate Entra ID app registration for user sign-in (delegated,
# authorization-code flow). Leave blank to fall back to the dev-only
# sign-in form at /auth/dev-login.
SSO_TENANT_ID=
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_REDIRECT_URI=http://localhost:8000/auth/callback

# Announce new tickets in a Teams channel. The switch is for every process that creates tickets;
# the webhook URL is a credential (anyone with it can post to the channel) and only the worker,
# which sends, needs it.
TEAMS_NEW_TICKET_ENABLED=false
TEAMS_NEW_TICKET_WEBHOOK_URL=
# Also send agents' unread notifications to that channel (an @mention of the person).
TEAMS_NOTIFICATIONS_ENABLED=false
# The Teams bot (phase 8): the public app serves POST /api/teams/messages and, with the worker, sends.
# APP_ID is the bot's Entra application (client) id, TENANT_ID our directory. The bot signs in to the Bot
# Connector with the client secret when one is set (a credential: only the public app and the worker hold it),
# otherwise as the managed identity whose client id is APP_ID (Azure only).
TEAMS_BOT_ENABLED=false
TEAMS_BOT_APP_ID=
TEAMS_BOT_TENANT_ID=
TEAMS_BOT_CLIENT_SECRET=
# Hosts a file sent to the bot may be downloaded from (suffixes, comma separated).
# TEAMS_FILE_HOST_SUFFIXES=.sharepoint.com,.sharepoint-df.com,.1drv.com
# Out-of-office detection: the worker reads agents' presence from Microsoft Graph (needs the GRAPH_*
# credentials, with Presence.Read.All and User.Read.All admin-consented).
PRESENCE_ENABLED=false
# Read a requester's Outlook mailbox time zone from Graph (needs MailboxSettings.Read, which cannot be scoped to
# the shared mailbox). Off by default: requesters use their account zone or the default time zone.
MAILBOX_TIME_ZONES_ENABLED=false
# Nightly Entra accountEnabled check (phase 6B): the worker makes agents whose account Entra disabled or deleted
# inactive. Needs the GRAPH_* credentials and User.Read.All (consented). Off by default.
ENTRA_ACCOUNT_CHECK_ENABLED=false
# Mail intake (worker only). GRAPH_SUBSCRIPTION_ENABLED keeps a Graph change-notification subscription on
# the shared mailbox alive (create, renew, recreate); GRAPH_NOTIFICATION_URL is the public https address of
# /webhooks/graph/notifications, which Microsoft must be able to reach, so leave both off locally.
# MAIL_CATCH_UP_ENABLED polls the inbox for mail the webhook missed (needs no public address).
GRAPH_SUBSCRIPTION_ENABLED=false
GRAPH_NOTIFICATION_URL=
MAIL_CATCH_UP_ENABLED=false
# Email out of the shared mailbox (agent replies, automatic notices, approval requests). off: nothing is
# queued. dev: queued and recorded as sent without contacting Graph; read them at /admin/outbound-mail
# (dev environment only). graph: the worker sends through Graph and needs the GRAPH_* values and
# GRAPH_SHARED_MAILBOX (Mail.Send, admin-consented and limited to that mailbox).
MAIL_SENDING=off
# Inbound mail: the worker turns the notifications the webhook stored into tickets and replies. Needs the
# GRAPH_* values and GRAPH_SHARED_MAILBOX (Mail.Read, admin-consented and limited to that mailbox). The intake
# limits (files kept per mail, tickets/replies per sender per hour, Cc followers) are admin settings.
INBOUND_ENABLED=false
# Where the app is reached (no trailing slash), so Teams cards can link to the ticket.
PUBLIC_BASE_URL=

# Used to sign session cookies. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET_KEY=change-me

# Comma-separated emails auto-promoted to super_admin on first login.
SUPER_ADMIN_EMAILS=

# Number of uvicorn worker processes (default 4).
# UVICORN_WORKERS=4
